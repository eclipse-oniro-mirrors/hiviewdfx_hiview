import("//base/hiviewdfx/hiview/hiview.gni")
import("//build/config/features.gni")
import("//build/test.gni")

ohos_fuzztest("DecoratorFuzzTest") {
  module_out_path = hiview_module + "/ucollection"

  fuzz_config_file = "//base/hiviewdfx/hiview/framework/native/unified_collection/collector/test/fuzztest/decorator_fuzzer"

  include_dirs = [
    "decorator_fuzzer.h",
    "$hiview_framework/native/unified_collection/decorator/include",
    "$hiview_framework/native/unified_collection/collector/inner_include",
    "$hiview_adapter/service/test/fuzztest/common/include",
    "$hiview_interfaces/inner_api/unified_collection",
  ]

  cflags = [
    "-g",
    "-O0",
    "-Wno-unused-variable",
    "-fno-omit-frame-pointer",
  ]

  sources = [ "decorator_fuzzer.cpp" ]

  deps = [
    "$hiview_base:hiviewbase",
    "$hiview_framework/native/unified_collection:ucollection_source",
  ]

  external_deps = [
    "bounds_checking_function:libsec_shared",
    "c_utils:utils",
    "ffrt:libffrt",
    "hilog:libhilog",
    "ipc:ipc_single",
    "safwk:system_ability_fwk",
    "samgr:samgr_proxy",
  ]
}
