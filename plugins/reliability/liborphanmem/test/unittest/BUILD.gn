import("//base/hiviewdfx/hiview/hiview.gni")
import("//build/test.gni")

module_output_path = "hiview/hiview/liborphanmem"

config("liborphanmem_ut_defaults") {
  cflags = [
    "-Wall",
    "-Wextra",
    "-Wno-error=unused-private-field",
    "-Wno-unused-parameter",
  ]
  include_dirs = [
    "$hiview_plugin/reliability/liborphanmem",
    "$hiview_plugin/reliability/liborphanmem/include",
    "$hiview_plugin/reliability/liborphanmem/allocator",
    "$hiview_plugin/reliability/liborphanmem/snapshot",
  ]
}

ohos_unittest("LibOrphanMemTest") {
  module_out_path = module_output_path
  sources = [
    "liborphanmem_test.cpp",
    "liborphanmem_detector_test.cpp",
  ]
  sources += [
    "$hiview_plugin/reliability/liborphanmem/leak_info.cpp",
    "$hiview_plugin/reliability/liborphanmem/process_mappings.cpp",
    "$hiview_plugin/reliability/liborphanmem/string_helper.cpp",
    "$hiview_plugin/reliability/liborphanmem/process_pipe.cpp",
    "$hiview_plugin/reliability/liborphanmem/heap_scanner.cpp",
    "$hiview_plugin/reliability/liborphanmem/scoped_signal_handler.cpp",
    "$hiview_plugin/reliability/liborphanmem/performance_tracer.cpp",
    "$hiview_plugin/reliability/liborphanmem/orphanmem_detector.cpp",
    "$hiview_plugin/reliability/liborphanmem/collect_thread.cpp",
    "$hiview_plugin/reliability/liborphanmem/thread_inspector.cpp",
    "$hiview_plugin/reliability/liborphanmem/thread_snapshot_impl.cpp",
    "$hiview_plugin/reliability/liborphanmem/snapshot/orphanmem_snapshot.cpp",
    "$hiview_plugin/reliability/liborphanmem/snapshot/orphanmem_snapshot_json_serializer.cpp",
    "$hiview_plugin/reliability/liborphanmem/allocator/map_allocator.cpp",
    "$hiview_plugin/reliability/liborphanmem/allocator/chunk.cpp",
    "$hiview_plugin/reliability/liborphanmem/allocator/heap_impl.cpp",
    "$hiview_plugin/reliability/liborphanmem/allocator/memory_mapper.cpp",
  ]
  configs = [ ":liborphanmem_ut_defaults" ]
  external_deps = [
    "c_utils:utils",
    "googletest:gtest_main",
    "hilog:libhilog",
    "faultloggerd:dfx_signalhandler",
  ]
  subsystem_name = "hiviewdfx"
  part_name = "hiview"
}

group("liborphanmem_unittest") {
  testonly = true
  deps = [
    ":LibOrphanMemTest",
  ]
}
