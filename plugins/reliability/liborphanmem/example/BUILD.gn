import("//build/ohos.gni")

ohos_shared_library("orphanmem_example") {
  sources = [
    "orphanmem_example.cpp",
  ]
  cflags = [
    "-Wall",
    "-Wextra",
    "-Werror",
    # "-Wno-error=unused-variable",
    # "-Wno-error=unused-function",
    "-frtti",
  ]
  branch_protector_ret = "pac_ret"
  sanitize = {
    cfi = true
    cfi_cross_dso = true
    debug = false
  }
  cflags_cc = [ "-Os" ]
  install_enable = false
  subsystem_name = "hiviewdfx"
  part_name = "hiview"
}

ohos_executable("orphanmem_example_main") {
  sources = [
    "main.cpp",
  ]
  cflags = [
    "-Wall",
    "-Wextra",
    "-Werror",
  ]
  deps = [
    ":orphanmem_example",
  ]
  branch_protector_ret = "pac_ret"
  sanitize = {
    cfi = true
    cfi_cross_dso = true
    debug = false
  }
  cflags_cc = [ "-Os" ]
  install_enable = false
  subsystem_name = "hiviewdfx"
  part_name = "hiview"
}
