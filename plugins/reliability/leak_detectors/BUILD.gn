ohos_prebuilt_etc("LeakDetectorsPipeline") {
  source = "etc/LeakDetectorsPipeline"
  relative_install_dir = "hiview/dispatch_rule"
  part_name = "hiview"
  subsystem_name = "hiviewdfx"
}

ohos_prebuilt_etc("LeakDetectorsListenerRule") {
  source = "etc/LeakDetectors"
  relative_install_dir = "hiview/listener_rule"
  part_name = "hiview"
  subsystem_name = "hiviewdfx"
}

group("leak_detector") {
  public_configs = [ ":leak_detector_telemetry_config" ]
  if (hiview_enable_leak_detector) {
    deps = [ ":libleakdetectors" ]
  }
}
